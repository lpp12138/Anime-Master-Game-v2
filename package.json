{
  "name": "anime-master-game-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "tsc --noEmit --incremental false && vite build",
    "start": "vite preview",
    "lint": "tsc --noEmit --incremental false",
    "worker:dev": "wrangler dev --local --port 8787 --var R2_PUBLIC_BASE_URL:http://localhost:8787/api/r2-images",
    "worker:deploy": "wrangler deploy",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "test:authority-budget": "node scripts/authority-write-budget.mjs",
    "test:room-chat": "tsx --test tests/room-chat.test.ts",
    "test:authority-vnext": "tsx --test tests/authority-vnext.test.ts",
    "test:authority-outbox": "tsx --test tests/authority-outbox.test.ts",
    "test:room-runtime-cutover": "tsx --test tests/room-runtime-cutover.test.ts",
    "test:authority-full-game": "tsx --test tests/authority-full-game.test.ts",
    "test:team-battle-spectator-view": "tsx --test tests/team-battle-spectator-view.test.ts",
    "test:room-entry-nickname": "tsx --test tests/room-entry-nickname.test.ts",
    "test:game-result-archive": "tsx --test tests/game-result-archive.test.ts",
    "test:question-set-creation-method": "tsx --test tests/question-set-creation-method.test.ts",
    "test:public-rooms": "tsx --test --test-name-pattern=\"public room\" tests/public-rooms.test.ts tests/public-room-sorting.test.ts tests/question-set-creation-method.test.ts",
    "test:question-set-creation-analysis": "tsx --test tests/question-set-creation-method-analysis.test.ts",
    "test:local-image-upload": "tsx --test tests/local-image-upload.test.ts",
    "test:r2-upload": "tsx --test tests/r2-upload.test.ts",
    "test:community-screenshot-upload": "tsx --test tests/community-screenshot-upload.test.ts tests/community-question-list.test.ts",
    "test:bangumi-api": "tsx --test tests/bangumi-api.test.ts",
    "test:game-rpc-response": "tsx --test tests/game-rpc-response.test.ts",
    "promo:prepare": "node scripts/prepare-promo-assets.mjs",
    "analyze:question-set-creation-method": "node scripts/analyze-question-set-creation-method.mjs",
    "backfill:question-set-creation-method": "node scripts/backfill-question-set-creation-method.mjs",
    "test:authority-state-machine": "tsx --test --test-name-pattern=\"seeded state-machine\" tests/authority-full-game.test.ts",
    "test:authority-local-runtime": "node scripts/authority-local-runtime.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply anime_master_game --local",
    "d1:migrate:remote": "wrangler d1 migrations apply anime_master_game --remote"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.0.16",
    "wrangler": "^4.124.0"
  }
}
